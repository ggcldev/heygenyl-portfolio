---
import { Image, Picture } from "astro:assets";
import liftedLogo from "../assets/testimonials/lifted-logo.png";
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import AgencyLogos from "../components/AgencyLogos.astro";
import SeoAuditForm from "../components/SeoAuditForm.astro";
import CtaArrow from "../components/CtaArrow.astro";
import ToolBrandIcon from "../components/ToolBrandIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
import gutterFeaturedImage from "../assets/case-studies/desert-it-solutions/desert-it-solutions-site.jpg";
import worksAutoCenterFeaturedImage from "../assets/case-studies/the-works-auto-center/the-works-auto-center-site.jpg";
import everythingProbateFeaturedImage from "../assets/case-studies/everything-probate/everwood-legal-site.jpg";
import tinkRecruitmentFeaturedImage from "../assets/case-studies/tink-recruitment/tink-recruitment-img-1-desktop.jpg";
import legitfitFeaturedImage from "../assets/case-studies/legitfit/legitfit-site.jpg";
import { getBlogPostSlug } from "../utils/blog";
import {
  topLevelServicePages,
  getChildServices,
  caseStudies,
  siteConfig,
} from "../data/site";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

// Kudos Insights: card tops line up and each slot gets its own image shape
// (width / height), giving the tall-short-tall-short rhythm.
const insightRatios = [2 / 3, 1.68, 3 / 4, 3 / 2];
const insightWidths = [320, 480, 640, 960, 1280, 1600];
const insightCards = posts.map((post, index) => {
  const image = post.data.image ?? gutterFeaturedImage;
  const ratio = insightRatios[index % insightRatios.length] ?? 4 / 3;
  // A tall crop of a wide image shows only its middle, so ask for a wider
  // file to keep it sharp. Phones use a fixed 4:3 crop.
  const sourceRatio = image.width / image.height;
  const scale = Math.max(1, sourceRatio / ratio);
  const phoneScale = Math.max(1, sourceRatio / (4 / 3));
  const widths = insightWidths.filter((w) => w <= image.width);
  return {
    post,
    image,
    ratio,
    widths: widths.length ? widths : [image.width],
    sizes: [
      `(max-width: 639px) ${Math.ceil(100 * phoneScale)}vw`,
      `(max-width: 1023px) ${Math.ceil(50 * scale)}vw`,
      `(min-width: 1920px) ${Math.ceil(480 * scale)}px`,
      `${Math.ceil(25 * scale)}vw`,
    ].join(", "),
  };
});

const featuredProjects = [
  {
    slug: "desert-it-solutions-msp",
    asset: gutterFeaturedImage,
    alt: "Desert IT Solutions MSP case study preview",
    cardShortTitle: "MSP",
    cardTitle: "Desert IT Solutions Case Study",
    cardSummary:
      "Desert I.T. Solutions is a Las Vegas-based managed IT company that helps businesses stay ahead of IT issues through proactive system monitoring, vulnerability management, and ongoing technical support. Their managed services model keeps clients' IT environments secure, functional, and equipped to scale with evolving technology demands.",
  },
  {
    slug: "the-works-auto-center-car-detailing",
    asset: worksAutoCenterFeaturedImage,
    alt: "The Works Auto Center case study preview",
  },
  {
    slug: "everything-probate-legal-firm",
    asset: everythingProbateFeaturedImage,
    alt: "Everything Probate case study preview",
  },
  {
    slug: "tink-recruitment-real-estate",
    asset: tinkRecruitmentFeaturedImage,
    alt: "Tink Recruitment case study preview",
  },
  {
    slug: "legitfit-fitness-software",
    asset: legitfitFeaturedImage,
    alt: "LegitFit case study preview",
  },
].map((item) => {
  const study = caseStudies.find((entry) => entry.slug === item.slug);
  if (!study) {
    throw new Error(`Unknown featured case study slug: ${item.slug}`);
  }
  return { ...item, study };
});

const approachSteps = [
  {
    id: "research-compete",
    title: "Research and Compete",
    copy:
      "I start with your competitors, not your website. I identify who's ranking at the top of your market and reverse engineer exactly why - their site structure, the pages driving their leads, the keywords they're targeting, and the gaps they're leaving open. This tells me what's already working in your market before I touch anything on your end.",
    tools: ["SEMrush", "Ahrefs", "Screaming Frog", "Google Search"],
  },
  {
    id: "audit-strategize",
    title: "Audit and Strategize",
    copy:
      "Once I know what the market looks like, I dig into your current site. I find what's already ranking, protect it, and identify what's holding you back. From there I build a keyword-driven roadmap - organized around how your customers actually search - so every page we build or improve has a clear purpose and a target.",
    tools: ["Google Search Console", "SEMrush", "Screaming Frog"],
  },
  {
    id: "build-optimize",
    title: "Build and Optimize",
    copy:
      "This is where the work happens. Clean site structure, dedicated service and city pages, technical fixes, on-page content written around your target keywords, strategic internal linking, and full Google Business Profile optimization - all executed in the right order so nothing cancels each other out.",
    tools: ["Screaming Frog", "Google Search Console", "WebCEO", "Local Falcon"],
  },
  {
    id: "track-report",
    title: "Track and Report",
    copy:
      "I track your keyword rankings, organic traffic, and GBP visibility every month. You get a clear, straightforward report - no SEO jargon, no vanity metrics. Just what moved, what it means for your business, and what we're focused on next.",
    tools: ["Google Search Console", "Agency Analytics", "Local Falcon", "SEMrush"],
  },
];

const serviceCardTitleBySlug: Record<string, string> = {
  seo: "SEO",
  "web-design": "Web Design",
};

const serviceCardSummaryBySlug: Record<string, string> = {
  seo:
    "Technical SEO, on-page optimization, and site audits that improve rankings and drive organic traffic to your website.",
  "web-design":
    "Conversion-focused WordPress web design built for speed, search visibility, and turning visitors into leads.",
};

const homeFaqGroups = [
  {
    label: "Working together",
    items: [
      {
        question: "What SEO services do you offer?",
        answer:
          "I specialize in SEO and WordPress development for local service businesses and agencies. That covers local SEO, on-page optimization, Google Business Profile management, and WordPress SEO depending on what your site and market actually need.",
      },
    ],
  },
  {
    label: "Process & Timeline",
    items: [
      {
        question: "What does your SEO process look like?",
        answer:
          "I start by understanding your business, your market, and what's already working before touching anything. From there we move into research, strategy, execution, and ongoing optimization so every decision has a reason behind it.",
      },
      {
        question: "How long does it take to see SEO results?",
        answer:
          "For SEO, you're looking at a minimum of 3 months to start seeing real movement, with full campaign support running up to 9 months. Timelines are always discussed upfront based on your goals, so nothing is set in stone until we talk.",
      },
    ],
  },
  {
    label: "Pricing & Payments",
    items: [
      {
        question: "How much does hiring a freelance SEO specialist cost?",
        answer:
          "Pricing depends on the scope and complexity of your project. I don't do one-size-fits-all packages. The best way to figure out what makes sense is to get on a quick call and go from there.",
      },
      {
        question: "How do payments and revisions work?",
        answer:
          "I require a 50% deposit before work begins, with the remaining balance due at agreed milestones or upon completion, all processed through Wise. Revisions are unlimited, because the goal is to get it right.",
      },
    ],
  },
];

const testimonialItems = [
  {
    id: "managed-it",
    quote:
      "Genyl consistently delivers work aligned with what we need, especially around technical SEO monitoring and audits for both global and local. His communication is strong, he's open to feedback, and he's genuinely easy to work with. What stood out most was his attitude and dedication. His eagerness to understand the business helped speed up the work significantly.",
    name: "Lifted",
    role: "Upwork Company",
    logo: liftedLogo,
  },
  {
    id: "local-service",
    quote:
      "Your feedback could be here. I'm currently helping businesses with SEO, technical audits, and website improvements. The next result here could be from your project.",
    name: "Your Name Here",
    role: "Owner",
  },
  {
    id: "agency",
    quote:
      "Your feedback could be here. I'm currently helping businesses with SEO, technical audits, and website improvements. The next result here could be from your project.",
    name: "Your Name Here",
    role: "Owner",
  },
];

const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    name: siteConfig.name,
    description: siteConfig.description,
    url: siteConfig.url,
    areaServed: "Worldwide",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Philippines",
      addressCountry: "PH",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homeFaqGroups.flatMap((group) => group.items).map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="Freelance SEO Specialist & WordPress SEO Expert | Hey Genyl"
  description="Freelance SEO specialist, local SEO, and WordPress SEO expert helping local businesses rank higher, drive more traffic, and attract qualified leads. Let's talk."
  schema={homeSchema}
>
  <div class="home-page">
    <Hero
      titleAccent={"Freelance SEO Specialist & Web Designer"}
      title="for Local Businesses and Agencies"
      role="SEO Specialist | Website Designer"
      description="Tired of watching competitors outrank you? I'm a freelance SEO specialist and WordPress SEO expert from the Philippines. I find the opportunities your market is missing and build strategies that drive real rankings, traffic, and growth for your business."
      actions={[
        { label: "View services", href: "/services/" },
        { label: "Contact", href: "/contact/" },
      ]}
    >
      <SeoAuditForm />
    </Hero>

    <AgencyLogos />

    <section
      class="content-shell band-light featured-projects-scroll"
      data-featured-scroll
      style={`--feature-count:${featuredProjects.length}; border-bottom: 1px solid var(--color-border);`}
    >
      <div class="featured-projects-shell py-24">
        <div class="featured-projects-copy">
          <div class="featured-projects-copy__text">
            <h2 class="section-eyebrow">Featured Projects</h2>
            <p class="text-sm text-muted mt-2">
              Five selected projects are highlighted here. The rest stay in the
              dedicated case-studies page.
            </p>
          </div>
          <div class="page-nav featured-projects-copy__cta">
            <a class="button primary" href="/case-studies/">
              <CtaArrow label="View All Case Studies" className="button-cta" />
            </a>
          </div>
        </div>

        <div class="featured-projects-stage" data-featured-stage>
          <div class="featured-projects-track" data-featured-track>
            {featuredProjects.map((project, index) => (
              <article class="featured-project-item">
                <div class="featured-project-card">
                  <a
                    class="featured-project-media"
                    href={`/case-studies/${project.study.slug}/`}
                  >
                    <div class="featured-project-device">
                      <div class="featured-project-screen">
                        <Picture
                          src={project.asset}
                          alt={project.alt}
                          formats={["avif", "webp"]}
                          fallbackFormat="webp"
                          widths={[640, 960, 1280, 1600]}
                          sizes="(max-width: 767px) 88vw, (max-width: 1200px) 62vw, 700px"
                          loading={index === 0 ? "eager" : "lazy"}
                          decoding="async"
                          fetchpriority={index === 0 ? "high" : "auto"}
                        />
                      </div>
                      <div class="featured-project-base" aria-hidden="true"></div>
                    </div>
                  </a>
                </div>
                <div class="featured-project-content">
                  <p class="flat-panel__kicker">
                    {project.cardShortTitle ?? project.study.shortTitle}
                  </p>
                  <h3 class="flat-panel__title">
                    {project.cardTitle ?? project.study.title}
                  </h3>
                  <p class="flat-panel__copy">
                    {project.cardSummary ?? project.study.summary}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="content-shell band-light">
      <div
        class="border-b py-24"
        style="border-color: var(--color-border);"
      >
        <div class="approach-header">
          <h2 class="section-eyebrow">My Approach to SEO</h2>
          <p class="approach-header__intro">
            Four focused steps from market research to honest reporting.
          </p>
        </div>

        <div class="w-full min-w-0">
          <ol class="approach-flow">
            {approachSteps.map((step, index) => (
              <li
                class="approach-flow__row"
                style={`--flow-progress: ${Math.round(((index + 1) / approachSteps.length) * 100)}%;`}
              >
                <div class="approach-flow__bar" aria-hidden="false">
                  <span class="approach-flow__bar-fill">
                    <span class="approach-flow__num">0{index + 1}</span>
                    <h3 class="approach-flow__title">{step.title}</h3>
                  </span>
                  <span class="approach-flow__ticks" aria-hidden="true"></span>
                </div>
                <div class="approach-flow__detail">
                  <p class="approach-flow__copy">{step.copy}</p>
                  <div class="approach-tools">
                    <p class="approach-tools__label">Tools</p>
                    <ul class="approach-tools__list">
                      {step.tools.map((tool) => (
                        <li class="approach-tools__item">
                          <ToolBrandIcon name={tool} className="approach-tools__icon" />
                          <span>{tool}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="content-shell band-light band-shade">
      <div class="py-24">
        <div class="approach-header">
          <h2 class="section-eyebrow">Services</h2>
          <p class="approach-header__intro">
            Get found on Google. Look good when they do.
          </p>
        </div>

        <div class="services-value-grid">
          {topLevelServicePages.map((service, index) => (
            <article class={`value-card${index % 2 === 1 ? " value-card--mint" : ""}`}>
              <span class="value-card__mark" aria-hidden="true"></span>
              <h3 class="value-card__title">
                {serviceCardTitleBySlug[service.slug] ?? service.title}
              </h3>
              <p class="value-card__copy">
                {serviceCardSummaryBySlug[service.slug] ?? service.summary}
              </p>
              <ul class="value-card__chips">
                {getChildServices(service.slug).map((child) => (
                  <li>
                    <a class="value-card__chip" href={`/services/${child.slug}/`}>
                      {child.navLabel ?? child.shortTitle}
                    </a>
                  </li>
                ))}
              </ul>
              <a class="value-card__cta" href={`/services/${service.slug}/`}>
                <CtaArrow label="View Service" className="value-card__cta-arrow" />
              </a>
              <span class="value-card__word" aria-hidden="true">
                {service.slug === "seo" ? "RANK" : "BUILD"}
              </span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="content-shell band-light band-shade">
      <div class="pt-24 pb-6">
        <h2 class="section-eyebrow">What Clients Say</h2>
      </div>
      <div
        class="border-b pt-0 pb-0"
        style="border-color: var(--color-border);"
      >
        <div class="testimonial-tabs" data-testimonial-tabs>
          <div class="testimonial-panels" data-testimonial-panels>
            {testimonialItems.map((item, index) => {
              const tabId = `testimonial-tab-${item.id}`;
              const panelId = `testimonial-panel-${item.id}`;
              const isActive = index === 0;

              return (
                <article
                  id={panelId}
                  class={`testimonial-panel${isActive ? " is-active" : ""}`}
                  role="tabpanel"
                  aria-labelledby={tabId}
                  aria-hidden={isActive ? "false" : "true"}
                  data-testimonial-panel-id={item.id}
                  hidden={!isActive}
                >
                  <p class="testimonial-panel__quote">"{item.quote}"</p>
                </article>
              );
            })}
          </div>

          <div
            class="testimonial-tablist"
            role="tablist"
            aria-label="Client testimonials"
          >
            {testimonialItems.map((item, index) => {
              const tabId = `testimonial-tab-${item.id}`;
              const panelId = `testimonial-panel-${item.id}`;
              const isActive = index === 0;

              return (
                <button
                  id={tabId}
                  type="button"
                  class="testimonial-tab"
                  role="tab"
                  aria-controls={panelId}
                  aria-selected={isActive ? "true" : "false"}
                  tabindex={isActive ? "0" : "-1"}
                  data-testimonial-tab-id={item.id}
                >
                  {"logo" in item && item.logo && (
                    <Image
                      src={item.logo}
                      alt={`${item.name} logo`}
                      class="testimonial-tab__logo"
                      width={48}
                      height={48}
                      loading="lazy"
                    />
                  )}
                  <span class="testimonial-tab__meta">
                    <span class="testimonial-tab__name">{item.name}</span>
                    <span class="testimonial-tab__role">{item.role}</span>
                  </span>
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="content-shell">
      <div
        class="border-b py-24"
        style="border-color: var(--color-border);"
      >
        <div class="insights-header">
          <p class="insights-eyebrow">Insights</p>
          <h2 class="insights-title">
            <span class="insights-title__accent">Recent</span> Posts
          </h2>
          <p class="insights-intro">
            Insights and guides on SEO, WordPress, and Local SEO from hands-on
            experience.
          </p>
        </div>

        <div class="insights-grid">
          {insightCards.map(({ post, image, ratio, widths, sizes }) => {
            const postSlug = getBlogPostSlug(post);
            return (
              <a
                class="insight-card"
                href={`/blog/${postSlug}/`}
                style={`--insight-ratio: ${ratio}`}
              >
                <div class="insight-card__media">
                  <Picture
                    src={image}
                    alt={post.data.imageAlt ?? `${post.data.title} post cover`}
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={widths}
                    sizes={sizes}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="insight-card__body">
                  <p class="insight-card__date">
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </p>
                  <h3 class="insight-card__title">{post.data.title}</h3>
                  <p class="insight-card__excerpt">{post.data.excerpt}</p>
                  <CtaArrow label="Read more" className="insight-card__more" />
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="content-shell band-light">
      <div
        class="border-b py-24"
        style="border-color: var(--color-border);"
      >
        <div class="insights-header">
          <p class="insights-eyebrow">FAQ</p>
          <h2 class="insights-title">
            <span class="insights-title__accent">Good questions,</span> honest
            answers
          </h2>
          <p class="insights-intro">
            Straight answers on scope, timelines, and how I handle projects.
          </p>
        </div>

        <div class="faq-groups">
          {homeFaqGroups.map((group) => (
            <div class="faq-group">
              <p class="faq-group__label">{group.label}</p>
              <div class="faq-group__items">
                {group.items.map((item) => (
                  <details class="home-faq-item" data-home-faq-item>
                    <summary class="home-faq-question" data-home-faq-trigger>
                      <span class="home-faq-num" aria-hidden="true"></span>
                      <h3 class="m-0">{item.question}</h3>
                      <span class="home-faq-icon" aria-hidden="true"></span>
                    </summary>
                    <div class="home-faq-answer" data-home-faq-answer>
                      <div class="home-faq-answer-inner" data-home-faq-answer-inner>
                        <p>{item.answer}</p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="content-shell band-light band-shade">
      <div class="home-closing">
        <p class="section-eyebrow">Next Step</p>
        <h2 class="home-closing__title">
          <span class="insights-title__accent">Tired of guessing</span> why your
          site isn't ranking?
        </h2>
        <p class="home-closing__intro">
          I'll take a look at what's holding you back and tell you exactly what
          needs to happen.
        </p>
        <div class="page-nav mt-10">
          <a class="button primary accent" href="/contact/">
            <CtaArrow label="Let's Talk" className="button-cta" />
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import "../scripts/homepage";
</script>
