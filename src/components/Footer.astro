---
import LogoMark from "./LogoMark.astro";
import { siteConfig, activeServicePages } from "../data/site";

const mainNav = [
	{ label: "Home", href: "/" },
	{ label: "Services", href: "/services/" },
	{ label: "Case Studies", href: "/case-studies/" },
	{ label: "Blog", href: "/blog/" },
	{ label: "Contact", href: "/contact/" },
];
---

<footer class="site-footer">
	<p class="site-footer__watermark" aria-hidden="true">HEYGENYL</p>
	<div class="content-shell site-footer__shell">
		<div class="site-footer__grid">
			<div class="site-footer__left">
				<a class="site-footer__mark" href="/" aria-label="Hey Genyl, home">
					<LogoMark class="site-footer__mark-svg" />
				</a>

				<p class="site-footer__statement">
					I choose <span>audits over assumptions</span> and
					<span>clarity over jargon</span>, because rankings you cannot
					explain are rankings you cannot keep.
				</p>

				<p class="site-footer__meta">
					SEO Specialist &amp; Website Designer<br />
					Based in the Philippines
				</p>

				<a
					class="site-footer__email"
					href="#"
					data-ml="hi|heygenyl.com"
					data-ml-label
				>
					hi [at] heygenyl.com
				</a>
			</div>

			<div class="site-footer__right">
				<nav class="site-footer__nav" aria-label="Footer">
					{mainNav.map((item) => (
						<a class="site-footer__nav-link" href={item.href}>
							{item.label}
						</a>
					))}
				</nav>

				<div class="site-footer__cols">
					<nav class="site-footer__col" aria-label="Footer services">
						<p class="site-footer__col-label">Services</p>
						{activeServicePages.map((service) => (
							<a
								class="site-footer__col-link"
								href={`/services/${service.slug}/`}
							>
								{service.navLabel ?? service.shortTitle}
							</a>
						))}
					</nav>

					<nav class="site-footer__col" aria-label="Footer legal">
						<p class="site-footer__col-label">Legal</p>
						<a class="site-footer__col-link" href="/privacy-policy/">
							Privacy Policy
						</a>
						<a
							class="site-footer__col-link"
							href="#"
							data-site-consent-open
						>
							Cookie Settings
						</a>
					</nav>
				</div>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p class="m-0">
				© {new Date().getFullYear()} {siteConfig.name}. All rights reserved.
			</p>
		</div>
	</div>
</footer>
