---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  siteConfig,
  servicePages,
  getChildServices,
  type ServicePage,
} from "../data/site";
import PageHero from "./PageHero.astro";

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
const serviceUrl = new URL(`/services/${service.slug}/`, siteConfig.url).toString();

// Nested services (e.g. "seo/local-seo") get a parent-hub crumb in the breadcrumb.
const parentSlug = service.slug.includes("/")
  ? service.slug.slice(0, service.slug.lastIndexOf("/"))
  : null;
const parentService = parentSlug
  ? servicePages.find((item) => item.slug === parentSlug)
  : null;

// Hub pages (SEO, Web Design) list their direct child services.
const childServices = getChildServices(service.slug);

const breadcrumbTrail = [
  { name: "Home", item: new URL("/", siteConfig.url).toString() },
  { name: "Services", item: new URL("/services/", siteConfig.url).toString() },
];
if (parentService) {
  breadcrumbTrail.push({
    name: parentService.shortTitle,
    item: new URL(`/services/${parentService.slug}/`, siteConfig.url).toString(),
  });
}
breadcrumbTrail.push({ name: service.shortTitle, item: serviceUrl });

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.shortTitle,
    serviceType: service.shortTitle,
    description: service.metaDescription,
    areaServed: "Worldwide",
    provider: {
      "@type": "Person",
      name: siteConfig.name,
    },
    url: serviceUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbTrail.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: crumb.item,
    })),
  },
];
---

<BaseLayout title={service.metaTitle} description={service.metaDescription} noIndex={service.noIndex ?? false} schema={schema}>
  <div class="services-page svc-detail">
    <PageHero
      eyebrow="Service page"
      title={service.title}
      intro={service.summary}
      accentLead={service.heroAccentLead}
      compact
      chips={service.chips}
      actions={[
        { label: "Start a project", href: "/contact/" },
        { label: "See case studies", href: "/case-studies/", variant: "secondary" },
      ]}
    />

    <section class="content-shell">
      <div class="focus" data-focus>
        <header class="focus__head">
          <p class="eyebrow focus__eyebrow">
            <span class="focus__tick" aria-hidden="true"></span>Services
          </p>
          <h2 class="focus__title">
            <span class="focus__title-accent">What I</span> handle
          </h2>
          <p class="focus__lead">
            Execution, prioritization, and the handoff your site actually needs.
          </p>
        </header>
        <ol class="focus__list">
          {service.deliverables.map((item, index) => (
            <li class="focus__row" style={`--row-index:${index}`}>
              <div class="focus__num">
                <span class="focus__diamond" aria-hidden="true"></span>
                <span class="focus__num-text">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <div class="focus__thumb">
                {item.image ? (
                  <img
                    src={item.image}
                    alt=""
                    width="120"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="focus__thumb-placeholder" aria-hidden="true"></span>
                )}
              </div>
              <h3 class="focus__row-title">{item.title}</h3>
              <p class="focus__row-copy">{item.copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {childServices.length > 0 && (
      <section class="content-shell">
        <div class="svc-block svc-children">
          <div class="svc-block__label">
            <h2>Explore</h2>
            <p>Specialized {service.navLabel ?? service.shortTitle} services under this area.</p>
          </div>
          <div class="svc-block__body">
            <ul class="svc-children__list">
              {childServices.map((child) => (
                <li>
                  <a class="svc-children__card" href={`/services/${child.slug}/`}>
                    <span class="svc-children__title">{child.navLabel ?? child.shortTitle}</span>
                    <span class="svc-children__copy">{child.summary}</span>
                    <span class="svc-children__cta" aria-hidden="true">View service →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <section class="content-shell">
      <div class="svc-block">
        <div class="svc-block__label">
          <h2>Best fit</h2>
          <p>Who this is for, and what you walk away with.</p>
        </div>
        <div class="svc-block__body fit-grid">
          <div class="fit-col">
            <p class="eyebrow">Ideal if you need</p>
            <ul class="check-list">
              {service.idealFor.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="fit-col">
            <p class="eyebrow">Likely outcomes</p>
            <ul class="check-list">
              {service.outcomes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="content-shell">
      <div class="svc-block">
        <div class="svc-block__label">
          <h2>Process</h2>
          <p>How we go from audit to results, step by step.</p>
        </div>
        <div class="svc-block__body">
          <ol class="steps">
            {service.process.map((step, index) => (
              <li class="step">
                <span class="step__num">{String(index + 1).padStart(2, "0")}</span>
                <div class="step__content">
                  <h3 class="step__title">{step.title}</h3>
                  <p class="step__copy">{step.copy}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="content-shell">
      <div class="svc-block svc-block--last">
        <div class="svc-block__label">
          <h2>FAQ</h2>
          <p>The questions buyers ask before getting started.</p>
        </div>
        <div class="svc-block__body">
          <div class="faq-list">
            {service.faq.map((item) => (
              <details class="faq">
                <summary class="faq__q">
                  <span>{item.question}</span>
                  <span class="faq__icon" aria-hidden="true"></span>
                </summary>
                <p class="faq__a">{item.answer}</p>
              </details>
            ))}
          </div>
          <div class="page-nav svc-cta">
            <a class="button primary" href="/contact/">Book a project intro</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .svc-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block: clamp(2.75rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .svc-block--last {
    border-bottom: 0;
  }

  @media (min-width: 1024px) {
    .svc-block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .svc-block__label {
      position: sticky;
      top: 6.5rem;
    }
  }

  .svc-block__label h2 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .svc-block__label p {
    margin: 0.55rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 26ch;
  }

  /* What I handle — Kudos "Our focus": left header column, right numbered list */
  .focus {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(2.75rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 1024px) {
    .focus {
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }

    .focus__head {
      position: sticky;
      top: 6.5rem;
    }
  }

  .focus__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .focus__tick {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  .focus__title {
    margin: 0.85rem 0 0;
    font-size: clamp(2.25rem, 4vw, 2.85rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .focus__title-accent {
    color: var(--color-accent);
  }

  .focus__lead {
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-size: clamp(0.95rem, 1.1vw, 1.02rem);
    line-height: 1.5;
    max-width: 32ch;
  }

  .focus__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .focus__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 1.5rem;
    padding-block: clamp(1.75rem, 3.5vw, 3rem);
    border-top: 1px dashed var(--color-border);
  }

  @media (min-width: 768px) {
    .focus__row {
      /* number → image → narrow title → flexible gap → narrower description */
      grid-template-columns:
        minmax(0, 0.5fr) auto minmax(0, 12rem) minmax(0, 0.35fr) minmax(0, 30rem);
      align-items: center;
      column-gap: clamp(1.5rem, 4vw, 4rem);
      row-gap: 0.5rem;
    }

    /* Push the description into the last track so the 1fr spacer widens the gap */
    .focus__row-copy {
      grid-column: 5;
    }
  }

  .focus__thumb {
    width: clamp(5rem, 7vw, 7.5rem);
    aspect-ratio: 1 / 1;
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
  }

  .focus__thumb img,
  .focus__thumb-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .focus__thumb-placeholder {
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-accent) 65%, #050505),
      color-mix(in oklab, var(--color-accent) 14%, #050505)
    );
  }

  .focus__num {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .focus__diamond {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
    transform: rotate(45deg);
    transition: transform 220ms ease;
  }

  .focus__num-text {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    transition: color 220ms ease;
  }

  .focus__row-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.7vw, 1.4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
    transition: color 220ms ease;
  }

  .focus__row-copy {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(0.98rem, 1.15vw, 1.06rem);
    line-height: 1.5;
    max-width: 60ch;
  }

  .focus__row:hover .focus__row-title,
  .focus__row:hover .focus__num-text {
    color: var(--color-accent);
  }

  .focus__row:hover .focus__diamond {
    transform: rotate(45deg) scale(1.3);
  }

  /* Staggered scroll reveal (enabled by JS; no-JS keeps content visible) */
  .focus__row[data-reveal] {
    opacity: 0;
    transform: translateY(40px);
  }

  .focus__row[data-reveal="in"] {
    opacity: 1;
    transform: none;
    transition:
      opacity 600ms ease,
      transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--row-index, 0) * 70ms);
  }

  /* Best fit — two checklist columns */
  .fit-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  @media (min-width: 768px) {
    .fit-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fit-col .eyebrow {
    display: block;
    margin-bottom: 1.1rem;
  }

  .check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .check-list li {
    position: relative;
    padding-left: 1.7rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .check-list li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.12em;
    width: 0.36rem;
    height: 0.66rem;
    border: solid var(--color-accent);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  /* Process — ghosted step numbers, divided timeline */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(1.25rem, 2.4vw, 1.85rem);
    border-top: 1px solid var(--color-border);
  }

  .step:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .step__num {
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: color-mix(in oklab, var(--color-ink) 20%, transparent);
  }

  .step__title {
    margin: 0 0 0.35rem;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .step__copy {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 62ch;
  }

  /* FAQ — accordion, no boxes */
  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  .faq {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    list-style: none;
    cursor: pointer;
    padding-block: clamp(1rem, 1.9vw, 1.35rem);
    font-weight: 600;
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    color: var(--color-ink);
    transition: color 150ms ease;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--color-accent);
  }

  .faq__q:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--color-accent) 55%, transparent);
    outline-offset: 4px;
  }

  .faq__icon {
    position: relative;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    background: var(--color-accent);
    transition: transform 200ms ease;
  }

  .faq__icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }

  .faq__icon::after {
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }

  .faq[open] .faq__icon::after {
    transform: translateX(-50%) scaleY(0);
  }

  .faq__a {
    margin: 0;
    padding-bottom: clamp(1rem, 1.9vw, 1.4rem);
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 72ch;
  }

  .svc-cta {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* Explore — hub pages link out to their child services */
  .svc-children__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .svc-children__card {
    display: grid;
    gap: 0.4rem;
    padding-block: clamp(1.25rem, 2.4vw, 1.85rem);
    border-bottom: 1px solid var(--color-border);
    transition: padding-left 200ms ease;
  }

  .svc-children__card:hover,
  .svc-children__card:focus-visible {
    padding-left: 0.5rem;
    outline: none;
  }

  .svc-children__card:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--color-accent) 55%, transparent);
    outline-offset: 4px;
  }

  .svc-children__title {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-ink);
    transition: color 200ms ease;
  }

  .svc-children__card:hover .svc-children__title,
  .svc-children__card:focus-visible .svc-children__title {
    color: var(--color-accent);
  }

  .svc-children__copy {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 64ch;
  }

  .svc-children__cta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .svc-children__card {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon::before,
    .faq__icon::after,
    .faq__q,
    .focus__diamond,
    .focus__num-text,
    .focus__row-title {
      transition: none;
    }

    .focus__row[data-reveal],
    .focus__row[data-reveal="in"] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Staggered scroll-reveal for the "What I handle" rows.
  // Content stays visible without JS; we only opt into the animation here.
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const focus = document.querySelector<HTMLElement>("[data-focus]");

  if (focus && !prefersReduced && "IntersectionObserver" in window) {
    const rows = focus.querySelectorAll<HTMLElement>(".focus__row");
    rows.forEach((row) => row.setAttribute("data-reveal", ""));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute("data-reveal", "in");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2, rootMargin: "0px 0px -10% 0px" },
    );

    rows.forEach((row) => observer.observe(row));
  }
</script>
